{
  "name": "kavolo-functions",
  "version": "1.0.0",
  "description": "Kavolo Firebase Cloud Functions (2nd Gen)",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
