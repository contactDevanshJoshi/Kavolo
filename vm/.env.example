# Kavolo VM Service Environment Configuration (SAD §9, §10, SRS SEC-3)
# Copy this file to .env on the VM and set real values. NEVER commit .env.

PORT=8080
LOG_LEVEL=info

# 32-byte hex key for AES-256-GCM decrypting tenant credentials in send_queue
CREDENTIAL_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# Groq Account B key (if required for any VM-side message processing)
GROQ_API_KEY_B=your_groq_account_b_key_here
