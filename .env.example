# Kavolo Environment Configuration Template
# Ref: SAD §9, §10, SRS SEC-1, SEC-3
# WARNING: NEVER commit actual secrets or .env files to Git.

# --- Cloud Functions / Secret Manager ---
# Set via: firebase functions:secrets:set <SECRET_NAME>
GROQ_API_KEY_A=gsk_...
GROQ_API_KEY_B=gsk_...
CREDENTIAL_ENCRYPTION_KEY=64_character_hex_key

# --- VM Service (.env on VM) ---
PORT=8080
LOG_LEVEL=info
